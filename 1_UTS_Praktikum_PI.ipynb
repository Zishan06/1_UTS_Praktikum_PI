import os
import re
import sys

from whoosh import index
from whoosh.index import create_in
from whoosh.fields import Schema, TEXT, ID
from whoosh.analysis import StandardAnalyzer
from whoosh.qparser import QueryParser
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.metrics.pairwise import cosine_similarity


# Stopword bahasa Indonesia sederhana
STOPWORDS = {
    "yang", "di", "ke", "dari", "pada", "dalam", "untuk",
    "dan", "atau", "dengan", "ini", "itu", "adalah",
    "sebagai", "oleh"
}


def preprocess_text(text):
    """Membersihkan teks: case folding, tokenisasi, dan stopword removal."""
    text = text.lower()
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    tokens = text.split()
    clean_tokens = [word for word in tokens if word not in STOPWORDS]
    return " ".join(clean_tokens)


def setup_whoosh_index(index_dir="indexdir"):
    """Membuat direktori dan indeks Whoosh baru."""
    os.makedirs(index_dir, exist_ok=True)

    schema = Schema(
        path=ID(stored=True, unique=True),
        source=TEXT(stored=True),
        content=TEXT(analyzer=StandardAnalyzer(), stored=True)
    )

    return create_in(index_dir, schema)


def load_and_index_datasets(base_dataset_path="dataset", index_dir="indexdir"):
    """Membaca file teks dari lima folder dataset dan mengindeksnya."""
    dataset_folders = ["etd-usk", "etd-ugm", "kompas", "tempo", "mojok"]

    if not os.path.isdir(base_dataset_path):
        print(f"Folder dataset '{base_dataset_path}' tidak ditemukan.")
        print("Buat folder dataset dan masukkan lima folder dataset ke dalamnya.")
        return

    print(f"Memulai proses indexing dari folder '{base_dataset_path}'...")

    ix = setup_whoosh_index(index_dir)
    writer = ix.writer()
    doc_count = 0

    try:
        for folder in dataset_folders:
            folder_path = os.path.join(base_dataset_path, folder)

            if not os.path.isdir(folder_path):
                print(f"Peringatan: folder '{folder_path}' tidak ditemukan. Dilewati.")
                continue

            # Membaca file .txt termasuk yang berada di subfolder
            for root, _, filenames in os.walk(folder_path):
                for filename in filenames:
                    file_path = os.path.join(root, filename)

                    if not filename.lower().endswith(".txt"):
                        continue

                    try:
                        with open(file_path, "r", encoding="utf-8") as file:
                            raw_text = file.read()

                        cleaned_text = preprocess_text(raw_text)

                        if not cleaned_text.strip():
                            print(f"File kosong setelah preprocessing: {file_path}")
                            continue

                        writer.add_document(
                            path=os.path.relpath(file_path, base_dataset_path),
                            source=folder,
                            content=cleaned_text
                        )
                        doc_count += 1

                    except (OSError, UnicodeError) as error:
                        print(f"Gagal membaca '{file_path}': {error}")

        writer.commit()
    except Exception:
        writer.cancel()
        raise

    print(f"Indexing selesai. {doc_count} dokumen berhasil diindeks.")
    print(f"Indeks disimpan di folder '{index_dir}'.")


def search_and_rank(query, index_dir="indexdir"):
    """Mencari dokumen dengan Whoosh dan merangkingnya dengan cosine similarity."""
    if not os.path.isdir(index_dir) or not index.exists_in(index_dir):
        print("Indeks belum tersedia. Pilih menu 1 terlebih dahulu.")
        return

    cleaned_query = preprocess_text(query)
    if not cleaned_query.strip():
        print("Query tidak memiliki kata yang dapat dicari.")
        return

    ix = index.open_dir(index_dir)

    with ix.searcher() as searcher:
        parser = QueryParser("content", schema=ix.schema)
        parsed_query = parser.parse(cleaned_query)
        results = searcher.search(parsed_query, limit=None)

        if not results:
            print("Dokumen tidak ditemukan.")
            return

        documents = [result["content"] for result in results]
        paths = [result["path"] for result in results]
        sources = [result["source"] for result in results]

        # Bag-of-Words dan cosine similarity
        vectorizer = CountVectorizer()
        document_vectors = vectorizer.fit_transform(documents)
        query_vector = vectorizer.transform([cleaned_query])

        scores = cosine_similarity(query_vector, document_vectors).flatten()

        ranked_results = sorted(
            zip(scores, paths, sources),
            key=lambda item: item[0],
            reverse=True
        )

        print("\n=== HASIL PENCARIAN ===")
        for rank, (score, path, source) in enumerate(ranked_results[:5], start=1):
            print(f"\nPeringkat          : {rank}")
            print(f"Dataset            : {source}")
            print(f"File               : {path}")
            print(f"Cosine Similarity  : {score:.4f}")


def main_menu():
    """Menu utama Command-Line Interface."""
    while True:
        print("\n=== INFORMATION RETRIEVAL SYSTEM ===")
        print("[1] Load & Index Dataset")
        print("[2] Search Query")
        print("[3] Exit")
        print("====================================")

        pilihan = input("Pilih menu (1/2/3): ").strip()

        if pilihan == "1":
            load_and_index_datasets(
                base_dataset_path="dataset",
                index_dir="indexdir"
            )
        elif pilihan == "2":
            query = input("Masukkan query pencarian: ").strip()
            if query:
                search_and_rank(query, index_dir="indexdir")
            else:
                print("Query tidak boleh kosong.")
        elif pilihan == "3":
            print("Keluar dari program. Terima kasih!")
            break
        else:
            print("Pilihan tidak valid, silakan coba lagi.")


if __name__ == "__main__":
    main_menu()

