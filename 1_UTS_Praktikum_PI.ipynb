    "    print(f\"Memulai proses Load & Index dari folder '{base_dataset_path}'...\")\n",
    "    \n",
    "    # Whoosh index\n",
    "    ix = setup_whoosh_index(index_dir)\n",
    "    writer = ix.writer()\n",
    "    \n",
    "    # Dataset\n",
    "    dataset_folders = [\"etd-usk\", \"etd-ugm\", \"kompas\", \"tempo\", \"mojok\"]\n",
